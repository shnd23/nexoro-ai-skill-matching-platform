# ─────────────────────────────────────────────────────────────────────────────
# Nexero — root .gitignore
# Covers: Python (matching-service), .NET (backend), Node.js (frontend)
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets & local config ───────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
*.so

# HuggingFace / sentence-transformers model cache
.cache/

# ── .NET ─────────────────────────────────────────────────────────────────────
bin/
obj/
*.user
*.suo
.vs/
*.DotSettings.user
TestResults/

# ── Node.js / Next.js ────────────────────────────────────────────────────────
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Docker ───────────────────────────────────────────────────────────────────
# Don't ignore docker-compose overrides
docker-compose.override.yml

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
